            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "incomestatement",
        "income statement api",
        "profit and loss api",
        "p&l api",
        "revenue api",
        "net income api"
    ],
    "homepage": "https://apiverve.com/marketplace/incomestatement?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/incomestatement",
        "source": "https://github.com/apiverve/incomestatement-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Incomestatement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Incomestatement\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
